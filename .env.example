# YatraAI configuration. Copy to `.env` (never commit it). Every external key is OPTIONAL:
# without keys the app runs in a clearly labelled demo mode.
# The backend reads ../.env or backend/.env; the frontend reads frontend/.env.local (see README).

# ---------------------------------------------------------------- general
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_DEMO_DATA=true                 # index the bundled demo travel guide at startup

# ---------------------------------------------------------------- database
# Default (blank) = SQLite file at backend/data/yatra.db. Docker Compose sets PostgreSQL automatically.
# DATABASE_URL=postgresql+asyncpg://yatra:CHANGE_ME@localhost:5433/yatra
POSTGRES_PASSWORD=change-me-for-anything-but-local-dev

# ---------------------------------------------------------------- vector store (Qdrant)
# Blank = embedded Qdrant on disk (backend/data/qdrant). Set to use a Qdrant server.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=yatra_chunks

# ---------------------------------------------------------------- embeddings
# auto: multilingual sentence-transformers model if installed (pip install -r backend/requirements-ml.txt),
#       otherwise a deterministic hashing fallback (English/lexical only).
EMBEDDING_BACKEND=auto              # auto | sentence_transformers | hashing
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------------------------------------------------------------- language model
# auto picks the first configured: Anthropic → OpenAI → Ollama → demo (quotes sources, no generation).
LLM_PROVIDER=auto                   # auto | anthropic | openai | ollama | demo
ANTHROPIC_API_KEY=                  # https://console.anthropic.com/ (billed separately from Claude Code)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low                # low | medium | high | xhigh | max
OPENAI_API_KEY=                     # https://platform.openai.com/api-keys
OPENAI_BASE_URL=                    # optional: any OpenAI-compatible endpoint
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=                    # e.g. http://localhost:11434 (free, local; https://ollama.com)
OLLAMA_MODEL=llama3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048

# ---------------------------------------------------------------- retrieval / chunking
RETRIEVAL_TOP_K=6
CHUNK_SIZE=900
CHUNK_OVERLAP=150
HISTORY_TURNS=8

# ---------------------------------------------------------------- crawler
CRAWLER_USER_AGENT=YatraAI-Bot/0.1 (+https://github.com/Dev8735/YatraAI-Travel-chatbot)
CRAWL_MAX_PAGES=25
CRAWL_MAX_DEPTH=2
CRAWL_TIMEOUT_SECONDS=15
CRAWL_MAX_BYTES=2000000
CRAWL_MAX_REDIRECTS=5
CRAWL_DELAY_SECONDS=0.5
CRAWL_ALLOW_PRIVATE_NETWORKS=false  # never true in production (rejected at startup)

# ---------------------------------------------------------------- Google Maps Platform (server-side key)
# Enables live Places (search, details, ratings, hours, photos) and Routes (road distance/duration).
# Console: https://console.cloud.google.com/google/maps-apis — enable "Places API (New)" and "Routes API".
# Restrict this key by API and (ideally) server IP. It is never sent to the browser.
GOOGLE_MAPS_API_KEY=
PLACES_PROVIDER=auto                # auto | google | demo
ROUTES_PROVIDER=auto                # auto | google | none

# ---------------------------------------------------------------- frontend
# BACKEND_URL is used by the Next.js server to proxy /api/* (frontend/.env.local or build arg).
BACKEND_URL=http://127.0.0.1:8000
# Browser key for the Maps Embed API only. It IS visible to users: restrict it by HTTP referrer
# and to the "Maps Embed API". Leave blank to hide maps.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# ---------------------------------------------------------------- abuse protection
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_INGEST_PER_HOUR=10
RATE_LIMIT_PROVIDERS_PER_MINUTE=60
